<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.github.paganini2008</groupId>
        <artifactId>kookaburra-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>kookaburra-core</artifactId>
    <name>Kookaburra Core</name>
    <description>Kookaburra embedded object database engine: storage, query engine, OQL</description>

    <dependencies>
        <dependency>
            <groupId>org.roaringbitmap</groupId>
            <artifactId>RoaringBitmap</artifactId>
        </dependency>
        <dependency>
            <groupId>org.antlr</groupId>
            <artifactId>antlr4-runtime</artifactId>
        </dependency>
        <!-- logging facade only: applications choose the backend (logback, log4j2, ...) -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- single source of all default settings: ../kookaburra.properties -->
            <resource>
                <directory>${project.basedir}/..</directory>
                <includes>
                    <include>kookaburra.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.antlr</groupId>
                <artifactId>antlr4-maven-plugin</artifactId>
                <version>${antlr.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>antlr4</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <visitor>true</visitor>
                    <listener>false</listener>
                </configuration>
            </plugin>
            <!-- The shared suites run twice: in memory (default-test) and on disk (disk-suite, real segment files / WAL). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>disk-suite</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <systemPropertyVariables>
                                <kookaburra.test.storage>disk</kookaburra.test.storage>
                            </systemPropertyVariables>
                            <includes>
                                <include>**/DynamicTest.java</include>
                                <include>**/DatabaseTest.java</include>
                                <include>**/OqlTest.java</include>
                                <include>**/OqlDifferentialTest.java</include>
                                <include>**/DifferentialTest.java</include>
                                <include>**/QueryApiTest.java</include>
                                <include>**/FluentQueryTest.java</include>
                                <include>**/ReadmeExamplesTest.java</include>
                                <include>**/TransactionTest.java</include>
                            </includes>
                            <reportNameSuffix>disk</reportNameSuffix>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
